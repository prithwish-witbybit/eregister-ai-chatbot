{
	"name": "eregister-ai-chat-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:test": "vite --mode test",
		"dev:feature": "vite --mode feature",
		"typecheck": "tsc --noEmit",
		"build:test": "tsc --noEmit && vite build --mode test",
		"build:feature": "tsc --noEmit && vite build --mode feature",
		"deploy:test": "npm run build:test && wrangler deploy --env test",
		"deploy:feature": "npm run build:feature && wrangler deploy --env feature",
		"dev:ai-preview": "vite --mode ai-preview",
		"build:ai-preview": "tsc --noEmit && vite build --mode ai-preview",
		"deploy:ai-preview": "npm run build:ai-preview && wrangler deploy --env ai-preview"
	},
	"dependencies": {
		"@ai-sdk/react": "^3.0.285",
		"agents": "0.22.0",
		"ai": "^6.0.168",
		"firebase": "^12.19.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"typescript": "^6.0.2",
		"vite": "^8.3.0",
		"wrangler": "^4.103.0"
	}
}
